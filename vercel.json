{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "salmon-tool.vercel.app"
        }
      ],
      "destination": "https://salmontool.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "salmon-tool.vercel.app"
        }
      ],
      "destination": "https://salmontool.com/:path+",
      "permanent": true
    }
  ]
}
